{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Carlobruno78/RENOVA_SIM_NEWS_FEED/schema/news-feed.schema.json",
  "title": "RENOVA Simulator News Hub Feed",
  "type": "object",
  "required": [
    "schema_version",
    "feed_version",
    "generated_utc",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "feed_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "simulator": {
      "type": "string",
      "enum": [
        "IRACING",
        "LMU"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sim",
          "published_utc",
          "category",
          "status",
          "severity",
          "it",
          "en",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sim": {
            "type": "string",
            "enum": [
              "IRACING",
              "LMU"
            ]
          },
          "published_utc": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "renova_relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "is_integrity": {
            "type": "boolean"
          },
          "it": {
            "type": "object",
            "required": [
              "title",
              "summary"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "workaround": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "en": {
            "type": "object",
            "required": [
              "title",
              "summary"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "workaround": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}